---
import "../styles/globals.css";
import SiteHeader from "../components/site/SiteHeader.tsx";
import SiteFooter from "../components/site/SiteFooter.tsx";
import { ClientRouter } from "astro:transitions";

interface Props {
	title: string;
	description: string;
	canonical: string;
	ogType?: "website" | "article";
	jsonLd?: Record<string, unknown>;
	noindex?: boolean;
	currentPath: string;
}

const {
	title,
	description,
	canonical,
	ogType = "website",
	jsonLd,
	noindex = false,
	currentPath,
} = Astro.props;

const ogImage =
	ogType === "article"
		? new URL(`/og${new URL(canonical).pathname.replace(/\/$/, "")}.png`, canonical).href
		: "https://taktak.hu/og-default.png";
const caseStudyRoute =
	ogType === "article" ? `${new URL(canonical).pathname.replace(/\/+$/, "")}/` : undefined;
const caseStudyIdentity =
	caseStudyRoute ? `case-study:${caseStudyRoute}` : undefined;
const caseStudyStatus = caseStudyRoute ? "published-ready" : undefined;
const caseStudyContentType = caseStudyRoute?.includes("/sherlocks/") ? "sherlock" : caseStudyRoute ? "machine" : undefined;
---

<!doctype html>
<html class="no-js" lang="en" transition:animate="none">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" type="image/x-icon" sizes="32x32" href="/favicon.ico" />
		<link rel="canonical" href={canonical} />
		<link
			rel="preload"
			href="/fonts/source-serif-4-latin-600-normal.woff2"
			as="font"
			type="font/woff2"
			crossorigin
		/>
		<meta property="og:type" content={ogType} />
		<meta property="og:site_name" content="taktak.hu" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		{caseStudyIdentity && <meta name="case-study-identity" content={caseStudyIdentity} />}
		{caseStudyRoute && <meta name="case-study-route" content={caseStudyRoute} />}
		{caseStudyStatus && <meta name="case-study-status" content={caseStudyStatus} />}
		{caseStudyContentType && <meta name="case-study-content-type" content={caseStudyContentType} />}
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="Security portfolio social preview" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />
		<meta name="author" content="TakTak" />
		<meta name="referrer" content="strict-origin-when-cross-origin" />
		<title>{title}</title>
		{noindex && <meta name="robots" content="noindex,nofollow" />}
		{
			jsonLd && (
				<script
					type="application/ld+json"
					is:inline
					set:html={JSON.stringify(jsonLd)
						.replace(/</g, "\\u003c")
						.replace(/>/g, "\\u003e")}
				/>
			)
		}
		{/* Pre-paint theme: resolves the stored/system choice before first paint
		    so the document never flashes the wrong palette. Absent storage = auto. */}
		<script is:inline>
			(() => {
				const root = document.documentElement;
				root.classList.remove("no-js");
				root.classList.add("js");
				let theme;
				try {
					const stored = localStorage.getItem("starlight-theme");
					if (stored === "light" || stored === "dark") {
						theme = stored;
					}
				} catch {}
				if (!theme) {
					theme = window.matchMedia("(prefers-color-scheme: dark)").matches
						? "dark"
						: "light";
				}
				document.documentElement.dataset.theme = theme;
				document.documentElement.style.colorScheme = theme;
			})();
		</script>
		<style is:global>
			html {
				scroll-padding-top: var(--portfolio-header-h, 5.5rem);
			}
			/* Navigation/skip-link focus target, not an interactive control. */
			#main-content:focus {
				outline: none;
			}
			.portfolio-skip-link {
				position: absolute;
				left: 1rem;
				top: -4rem;
				z-index: 10000;
				border: 1px solid var(--portfolio-accent);
				border-radius: var(--portfolio-radius);
				padding: 0.6rem 1rem;
				background: var(--portfolio-surface-raised);
				color: var(--portfolio-accent);
				font-weight: 700;
				text-decoration: none;
				transition: top 0.15s ease;
			}
			.portfolio-skip-link:focus {
				top: 1rem;
				outline: 3px solid var(--portfolio-accent);
				outline-offset: 2px;
			}
		</style>
	</head>
	<body>
		<a class="portfolio-skip-link" href="#main-content"
			>Skip to main content</a
		>
		{/* Decorative grain overlay, rendered exactly once per page. */}
		<svg class="surface-grain" aria-hidden="true" focusable="false">
			<filter id="surface-grain-noise">
				<feTurbulence
					type="fractalNoise"
					baseFrequency="0.82"
					numOctaves="2"
					stitchTiles="stitch"></feTurbulence>
			</filter>
			<rect width="100%" height="100%" filter="url(#surface-grain-noise)"
			></rect>
		</svg>
		<SiteHeader currentPath={currentPath} client:load transition:persist />
		<slot />
		<SiteFooter />
		{/* Measured header height feeds `--portfolio-header-h`, consumed by
		    `scroll-padding-top` so in-page anchors clear the sticky header.
		    Guarded so a second run cannot stack observers. */}
		<script is:inline>
			(() => {
				const initKey = Symbol.for("taktak.portfolio.header-height");
				if (window[initKey]) return;
				window[initKey] = true;
				const root = document.documentElement;
				// Re-raster the fixed SVG grain after a resize settles. A single
				// trailing-debounced replace keeps no work running during a drag.
				let grainTimer;
				window.addEventListener(
					"resize",
					() => {
						window.clearTimeout(grainTimer);
						grainTimer = window.setTimeout(() => {
							const grain = document.querySelector(".surface-grain");
							if (grain) grain.replaceWith(grain.cloneNode(true));
						}, 150);
					},
					{ passive: true },
				);
				let headerObserver;
				let headerResizeFallback;
				const bindHeader = () => {
					headerObserver?.disconnect();
					if (headerResizeFallback) {
						window.removeEventListener("resize", headerResizeFallback);
					}
					const header = document.querySelector(".portfolio-header");
					if (!header) return;
					const measure = () =>
						root.style.setProperty(
							"--portfolio-header-h",
							`${header.getBoundingClientRect().height}px`,
						);
					measure();
					if (typeof ResizeObserver !== "undefined") {
						headerObserver = new ResizeObserver(measure);
						headerObserver.observe(header);
					} else {
						headerResizeFallback = measure;
						window.addEventListener("resize", headerResizeFallback);
					}
				};
				document.addEventListener("astro:before-swap", (event) => {
					const nextRoot = event.newDocument.documentElement;
					nextRoot.classList.remove("no-js");
					nextRoot.classList.add("js");
					const theme = root.dataset.theme;
					const colorScheme = root.style.colorScheme;
					if (theme) nextRoot.dataset.theme = theme;
					else delete nextRoot.dataset.theme;
					if (colorScheme) nextRoot.style.colorScheme = colorScheme;
					else nextRoot.style.removeProperty("color-scheme");
				});
				bindHeader();
				// Register before ClientRouter starts, even if React hydration is slow.
				// Initial page load keeps its native focus; only swaps move it to main.
				let needsNavigationFocus = false;
				document.addEventListener("astro:page-load", () => {
					if (!needsNavigationFocus) return;
					needsNavigationFocus = false;
					document.getElementById("main-content")?.focus({ preventScroll: true });
				});
				document.addEventListener("astro:after-swap", () => {
					needsNavigationFocus = true;
					bindHeader();
					requestAnimationFrame(() => {
						const header = document.querySelector(".portfolio-header");
						if (
							header &&
								root.style.getPropertyValue("--portfolio-header-h") !==
									`${header.getBoundingClientRect().height}px`
						) {
							bindHeader();
						}
					});
				});
			})();
		</script>
		<script src="/scripts/prefetch.js" type="module" is:inline></script>
		<ClientRouter />
	</body>
</html>
