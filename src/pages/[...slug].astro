---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { execFileSync } from 'node:child_process';
import BaseLayout from '../layouts/BaseLayout.astro';
import { SidebarNav } from '../components/site/SidebarNav.tsx';
import { Toc } from '../components/site/Toc.tsx';
import { Pagination } from '../components/site/Pagination.tsx';
import { DocsMeta } from '../components/site/DocsMeta.tsx';
import { CaseRail } from '../components/site/CaseRail.tsx';
import { CaseInfoPanel } from '../components/site/CaseInfoPanel.tsx';
import { MobileContents } from '../components/site/MobileContents.tsx';
import Explorer from '../components/home/Explorer.tsx';
import type { Study } from '../components/home/types';
import { resolveCategory } from '../lib/category.ts';
import { PERSON, PERSON_ID } from '../lib/schema.ts';

export async function getStaticPaths() {
	const entries = await getCollection('docs');
	return entries.map((entry) => {
		const route = entry.id.endsWith('/index')
			? entry.id.slice(0, -'/index'.length)
			: entry.id;
		return { params: { slug: route }, props: { entry, entries } };
	});
}

type Props = {
	entry: CollectionEntry<'docs'>;
	entries: CollectionEntry<'docs'>[];
};
const { entry, entries } = Astro.props;

const { Content, headings } = await render(entry);

const isCase = entry.data.type === 'case-study';

const title = `${entry.data.seoTitle ?? entry.data.title} | taktak.hu`;
const description = entry.data.description;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const currentPath = Astro.url.pathname;

const categoryKey = entry.id.split('/').slice(0, -1).join('/');
const category = isCase ? resolveCategory(entry.id) : null;
const categoryName = category?.label ?? '';
const railLabel = `${categoryName} cases`;
const categoryHref = category ? `/case-studies/htb/${category.key}/` : '';

// Same-category cases, newest first, id as tiebreak, current page excluded.
const related = entries
	.filter(
		(item) =>
			item.data.type === 'case-study' &&
			item.id !== entry.id &&
			item.id.split('/').slice(0, -1).join('/') === categoryKey,
	)
	.sort((a, b) => {
		const aDate = a.data.addedAt ?? '';
		const bDate = b.data.addedAt ?? '';
		return aDate === bDate ? a.id.localeCompare(b.id) : bDate.localeCompare(aDate);
	})
	.slice(0, 3)
	.map((item) => ({ href: '/' + item.id + '/', title: item.data.title }));

// The case panel's date rows reflect the frontmatter field they carry: only a
// real `publishedAt` is labelled "Published"; the portfolio-addition date is
// labelled "Added". Labels never come from the Git commit fallback used for
// non-case documentation pages.
const published = entry.data.publishedAt ?? entry.data.addedAt;
const publishedLabel = entry.data.publishedAt ? 'Published' : 'Added';
const updated = entry.data.updatedAt;
const updatedLabel = 'Updated';

const reportUrl = `https://github.com/taktak0x/security-portfolio/issues/new?${new URLSearchParams(
	{
		title: `Correction: ${entry.data.title}`,
		body: `Page: ${new URL(Astro.url.pathname, Astro.site)}\n\nWhich specific claim needs correcting, and what should it say?`,
	},
).toString()}`;

// Non-case leaf pages get prev/next from their parent-directory siblings,
// ordered by title. Case pages and index pages get none. The loader strips a
// trailing `/index` from `entry.id`, so index entries are detected by filename.
const isIndexEntry = (item: CollectionEntry<'docs'>) =>
	(item.filePath ?? '').split('/').pop()?.replace(/\.(md|mdx)$/, '') === 'index';

// Credential records are sibling links in the Pro Labs index, not a linear
// document sequence, so they never get prev/next pagination.
const isCredential = entry.id.startsWith('prolabs/') && !isIndexEntry(entry);

let prev: { href: string; title: string } | undefined;
let next: { href: string; title: string } | undefined;
if (!isCase && !isIndexEntry(entry) && !isCredential) {
	const siblings = entries
		.filter(
			(item) =>
				item.id.split('/').slice(0, -1).join('/') === categoryKey &&
				!isIndexEntry(item),
		)
		.sort((a, b) => a.data.title.localeCompare(b.data.title));
	const position = siblings.findIndex((item) => item.id === entry.id);
	const toLink = (item: CollectionEntry<'docs'>) => ({
		href: '/' + item.id + '/',
		title: item.data.title,
	});
	if (position > 0) prev = toLink(siblings[position - 1]);
	if (position !== -1 && position < siblings.length - 1)
		next = toLink(siblings[position + 1]);
}

// Human-readable labels for the known portfolio URL segments; any other segment
// falls back to title-casing its hyphenated words. Mirrors the breadcrumb
// labels emitted in the case JSON-LD.
const SEGMENT_LABELS: Record<string, string> = {
	'case-studies': 'Case Studies',
	prolabs: 'Pro Labs',
	htb: 'Hack The Box',
	sherlocks: 'Sherlocks',
	dfir: 'DFIR',
	soc: 'SOC',
	machines: 'Machines',
	windows: 'Windows',
	linux: 'Linux',
};
const labelFor = (segment: string) =>
	SEGMENT_LABELS[segment] ??
	segment
		.split('-')
		.filter(Boolean)
		.map((word) => word.charAt(0).toUpperCase() + word.slice(1))
		.join(' ');

// Index entries would otherwise dead-end: list their descendant case studies,
// grouped by the directory they live in. Same newest-first / id-tiebreak order
// as the related list above. Leaf category pages yield a single group.
const isIndex = isIndexEntry(entry);
const descendantGroups: {
	label: string;
	items: { href: string; title: string; description?: string }[];
}[] = [];
if (isIndex) {
	const prefix = entry.id + '/';
	const descendants = entries
		.filter(
			(item) =>
				item.data.type === 'case-study' && item.id.startsWith(prefix),
		)
		.sort((a, b) => {
			const aDate = a.data.addedAt ?? '';
			const bDate = b.data.addedAt ?? '';
			return aDate === bDate ? a.id.localeCompare(b.id) : bDate.localeCompare(aDate);
		});
	const grouped = new Map<string, typeof descendants>();
	for (const item of descendants) {
		const segment = item.id.split('/').at(-2) ?? '';
		const group = grouped.get(segment);
		if (group) group.push(item);
		else grouped.set(segment, [item]);
	}
	for (const [segment, items] of grouped) {
		descendantGroups.push({
			label: labelFor(segment),
			items: items.map((item) => ({
				href: '/' + item.id + '/',
				title: item.data.title,
				description: item.data.description,
			})),
		});
	}
	descendantGroups.sort((a, b) => a.label.localeCompare(b.label));
}

// The `/case-studies/` library page is the canonical searchable archive: it is
// the explorer's one mount point and carries the full serialisable payload. The
// homepage keeps only a short recent-work rail, so the explorer is not rendered
// there. Category/label derivation mirrors that rail.
const isCaseStudiesIndex = entry.id === 'case-studies';
let archiveStudies: Study[] = [];
if (isCaseStudiesIndex) {
	const raw = entries
		.filter(
			({ id, data }) =>
				id.startsWith('case-studies/') &&
				data.type === 'case-study' &&
				data.status === 'published-ready',
		)
		.sort((a, b) => a.data.title.localeCompare(b.data.title));
	const categoryOf = (study: CollectionEntry<'docs'>): Study['category'] => {
		const resolved = resolveCategory(study.id);
		if (!resolved) throw new Error(`Unknown case-study path: ${study.id}`);
		return resolved.key.split('/').at(-1) as Study['category'];
	};
	const labelOf = (kind: string) =>
		kind === 'dfir'
			? 'DFIR / Sherlock'
			: kind === 'soc'
				? 'SOC / Sherlock'
			: `${kind[0].toUpperCase()}${kind.slice(1)} machine`;
	const cleanDescription = (value: string) =>
		value
			.replace(/^A\s+sanitized\s+/i, '')
			.replace(/^sanitized\s+/i, '')
			.replace(/^./, (char) => char.toUpperCase());
	const searchableText = (study: CollectionEntry<'docs'>) =>
		[
			study.data.title,
			cleanDescription(study.data.description),
			categoryOf(study),
			labelOf(categoryOf(study)),
			...(study.data.tags ?? []),
			study.data.objective,
			...(study.data.tools ?? []),
			study.data.skill,
			study.data.outcome,
		]
			.filter(Boolean)
			.join(' ')
			.replace(/\s+/g, ' ')
			.trim()
			.toLowerCase();
	archiveStudies = raw.map((study) => {
		const kind = categoryOf(study);
		return {
			id: study.id,
			href: `/${study.id}/`,
			title: study.data.title,
			description: cleanDescription(study.data.description),
			category: kind,
			label: labelOf(kind),
			tools: study.data.tools ?? [],
			tags: study.data.tags ?? [],
			addedAt: study.data.addedAt ?? '',
			search: searchableText(study),
		};
	});
}

// Page archetypes. The catch-all renders six shapes from one grid: the case
// report, the searchable archive, the static collection indexes, the method
// reference document, the credential records and the profiles index. The
// `data-page` value comes from the route; case pages keep every rail, and each
// other archetype picks only the chrome its shape needs.
const isMethod = entry.id === 'method';
const isProfiles = entry.id === 'profiles';
const pageKind = isCase
	? 'case'
	: isCredential
		? 'credential'
		: isMethod
			? 'method'
			: isProfiles
				? 'profiles'
				: isCaseStudiesIndex
					? 'archive'
					: isIndex
						? 'collection-index'
						: 'page';

// The left rail is site navigation: meaningful for case pages and any future
// fallback document. Collection indexes are their own navigation, method and
// credentials use the reading rail, and profiles stays a bare index; the header
// and footer keep section navigation on every page.
const showLeftRail = pageKind === 'case' || pageKind === 'page';
// The right rail is the case info panel, or the on-this-page table of contents
// for the reference-style reading pages. The fallback document keeps it: it is
// a three-column document (navigation rail, article, contents), so the base
// three-track route must have a matching third child.
const showRightRail =
	pageKind === 'case' ||
	pageKind === 'method' ||
	pageKind === 'credential' ||
	pageKind === 'page';
// A git last-updated line is only meaningful on document pages, not on the
// collection or profile indexes.
const showDocsMeta =
	pageKind === 'method' || pageKind === 'credential' || pageKind === 'page';

let lastUpdated: string | undefined;
if (showDocsMeta) {
	try {
		const commitDate = execFileSync(
			'git',
			['log', '-1', '--format=%cs', '--', entry.filePath],
			{ cwd: process.cwd() },
		)
			.toString()
			.trim();
		lastUpdated = commitDate || undefined;
	} catch {
		lastUpdated = undefined;
	}
}

// JSON-LD is emitted only on case pages: an Article node plus a BreadcrumbList
// built from the canonical pathname. Non-case pages get none.
let jsonLd: Record<string, unknown> | undefined;
if (isCase) {
	const pathname = Astro.url.pathname.replace(/\/+$/, '') || '/';
	const segments = pathname.split('/').filter(Boolean);
	const breadcrumbItems = segments.map((segment, index, all) => ({
		'@type': 'ListItem',
		position: index + 1,
		name: labelFor(segment),
		item: new URL(
			`/${all.slice(0, index + 1).join('/')}/`,
			Astro.site ?? canonical,
		).href,
	}));
	const article: Record<string, unknown> = {
		'@type': 'Article',
		headline: entry.data.title,
		author: { '@id': PERSON_ID },
		publisher: { '@id': PERSON_ID },
	};
	if (entry.data.description) article.description = entry.data.description;
	const datePublished = entry.data.publishedAt ?? entry.data.addedAt;
	if (datePublished) article.datePublished = datePublished;
	if (entry.data.updatedAt) article.dateModified = entry.data.updatedAt;
	article.url = canonical;
	jsonLd = {
		'@context': 'https://schema.org',
		'@graph': [
			article,
			PERSON,
			{ '@type': 'BreadcrumbList', itemListElement: breadcrumbItems },
		],
	};
}

const panelProps = {
	categoryLabel: categoryName,
	tools: entry.data.tools ?? [],
	skill: entry.data.skill,
	tags: entry.data.tags ?? [],
	published,
	publishedLabel,
	updated,
	updatedLabel,
	evidenceQuality: entry.data.evidenceQuality,
	related,
	reportUrl,
};
---

<BaseLayout
	title={title}
	description={description}
	canonical={canonical}
	ogType={isCase ? 'article' : 'website'}
	jsonLd={jsonLd}
	currentPath={currentPath}
>
	<main id="main-content" tabindex="-1" class="bg-background" data-page={pageKind}>
		{
			pageKind === 'page' && (
				<div class="mx-auto w-full max-w-[var(--portfolio-max-width)] px-4 pb-6 xl:hidden">
					<details class="rounded-[var(--portfolio-radius)] border border-border bg-card">
						<summary class="cursor-pointer list-none px-4 py-3 font-mono text-sm font-medium text-foreground portfolio-disclosure">
							Sections
						</summary>
						<div class="px-4 pb-4">
							<SidebarNav currentPath={currentPath} />
						</div>
					</details>
				</div>
			)
		}

		{
			isCase && (
				<div class="mx-auto w-full max-w-[var(--portfolio-max-width)] px-4 pt-6 xl:hidden">
					<a
						href={categoryHref}
						class="inline-flex min-h-6 items-center gap-1 font-mono text-[0.78rem] tracking-[0.02em] text-primary no-underline hover:underline focus-visible:underline"
					>
						<span aria-hidden="true">←</span> Back to {railLabel}
					</a>
				</div>
			)
		}

		<div
			class="portfolio-route mx-auto grid w-full max-w-[var(--portfolio-max-width)] grid-cols-1 gap-10 px-4 py-10 lg:px-8"
		>
			{
				showLeftRail && (
					<div class="hidden xl:block">
						<div class="sticky top-[calc(var(--portfolio-header-h,5.5rem)+1rem)]">
							{isCase ? (
								<CaseRail
									client:load
									categoryHref={categoryHref}
									categoryLabel={railLabel}
									headings={headings}
								/>
							) : (
								<SidebarNav currentPath={currentPath} />
							)}
						</div>
					</div>
				)
			}

			<div class="min-w-0">
				<article data-page={pageKind}>
					<div class="portfolio-prose">
						<h1 id="_top">{entry.data.title}</h1>
					</div>
					{
						isCase && (
							<div class="pb-6 xl:hidden">
								<details class="rounded-[var(--portfolio-radius)] border border-border bg-card">
									<summary class="cursor-pointer list-none px-4 py-3 font-mono text-sm font-medium text-foreground portfolio-disclosure">
										Case facts
									</summary>
									<div class="px-4 pb-4">
										<CaseInfoPanel {...panelProps} variant="facts" />
									</div>
								</details>
							</div>
						)
					}
					{(isCase || isMethod || isCredential || pageKind === 'page') && (
						<MobileContents
							headings={headings}
							depths={isCase ? [2] : [2, 3]}
							ariaLabel={isCase ? 'Case contents' : 'Page contents'}
						/>
					)}
					<div class="portfolio-prose">
						<Content />
						{
							isIndex && !isCaseStudiesIndex && descendantGroups.length > 0 && (
								<nav
									class="portfolio-index"
									aria-label={`Case studies in ${entry.data.title}`}
								>
									{descendantGroups.map((group) => (
										<>
											{descendantGroups.length > 1 && <h2>{group.label}</h2>}
											<ul>
												{group.items.map((item) => (
													<li>
														<a href={item.href}>{item.title}</a>
														{item.description && (
															<span class="portfolio-index__description">
																{item.description}
															</span>
														)}
													</li>
												))}
											</ul>
										</>
									))}
								</nav>
							)
						}
					</div>
				</article>
				{
					isCaseStudiesIndex && (
						<div>
							<Explorer
								studies={archiveStudies}
								client:load
							/>
						</div>
					)
				}
				{
					!isCase && (
						<>
							{showDocsMeta && <DocsMeta lastUpdated={lastUpdated} />}
							<Pagination prev={prev} next={next} />
						</>
					)
				}
			</div>

			{
				showRightRail && (
					<div class="hidden xl:block">
						<div class="sticky top-[calc(var(--portfolio-header-h,5.5rem)+1rem)]">
							{isCase ? <CaseInfoPanel {...panelProps} /> : <Toc headings={headings} />}
						</div>
					</div>
				)
			}
		</div>

		{
			isCase && (
				<div class="mx-auto w-full max-w-[var(--portfolio-max-width)] px-4 pb-10 xl:hidden">
					<details class="rounded-[var(--portfolio-radius)] border border-border bg-card">
						<summary class="cursor-pointer list-none px-4 py-3 font-mono text-sm font-medium text-foreground portfolio-disclosure">
							Related cases and provenance
						</summary>
						<div class="px-4 pb-4">
							<CaseInfoPanel {...panelProps} variant="related" />
						</div>
					</details>
				</div>
			)
		}
	</main>
</BaseLayout>
