---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
	title="Page not found | taktak.hu"
	description="That page does not exist."
	canonical="https://taktak.hu/404"
	ogType="website"
	currentPath="/404"
	noindex
>
	<main id="main-content" tabindex="-1" class="mx-auto w-full max-w-[var(--portfolio-max-width)] px-4 py-10 lg:px-8">
		<h1 class="text-[length:var(--step-4)] font-semibold tracking-tight leading-[var(--lh-tight)]">Page not found</h1>
		<p class="mt-4 max-w-[var(--portfolio-copy)] text-muted-foreground">
			This page does not exist or may have moved.
		</p>
		<p class="mt-6">
			<a class="text-primary no-underline hover:underline" href="/">Go to the homepage</a>
			<span class="text-muted-foreground"> or </span>
			<a class="text-primary no-underline hover:underline" href="/archive/">browse the archive</a>.
		</p>
		<p class="mt-2">
			<a class="text-primary no-underline hover:underline" href="/blog/">Read the blog</a>
			<span class="text-muted-foreground"> or </span>
			<a class="text-primary no-underline hover:underline" href="/lab/">visit the lab</a>.
		</p>
	</main>
</BaseLayout>
