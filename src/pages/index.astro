---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import HomeHero from "../components/home/HomeHero.tsx";
import FocusCards from "../components/home/FocusCards.tsx";
import type { Study } from "../components/home/types";
import { resolveCategory } from "../lib/category.ts";
import { PERSON, PERSON_ID } from "../lib/schema.ts";

const title = "TakTak — Security Portfolio";
const description =
	"Security case studies across red and blue team work, incident investigation, and Windows and Active Directory environments.";

const allDocs = await getCollection("docs");
const studiesRaw = allDocs
	.filter(
		({ id, data }) =>
			id.startsWith("case-studies/") &&
			data.type === "case-study" &&
			data.status === "published-ready",
	)
	.sort((a, b) => a.data.title.localeCompare(b.data.title));

// Category derived from collection path so cards show factual, path-based labels.
const category = (study: (typeof studiesRaw)[number]): Study["category"] => {
	const resolved = resolveCategory(study.id);
	if (!resolved) throw new Error(`Unknown case-study path: ${study.id}`);
	return resolved.key.split("/").at(-1) as Study["category"];
};
const label = (kind: string) =>
	kind === "dfir"
		? "DFIR / Sherlock"
		: kind === "soc"
			? "SOC / Sherlock"
		: `${kind[0].toUpperCase()}${kind.slice(1)} machine`;
// Overview rail: the newest three case studies. Explicit immutable `addedAt`
// (portfolio-addition date) descending, then stable id ascending. Entries
// without `addedAt` are omitted. No Git commit time or file mtime is read, and
// `featured` is not consulted. The full searchable archive, with its own URL
// state contract, lives at `/case-studies/`.
const railStudies: Study[] = studiesRaw
	.filter((study) => study.data.addedAt)
	.sort(
		(a, b) =>
			(b.data.addedAt ?? "").localeCompare(a.data.addedAt ?? "") ||
			a.id.localeCompare(b.id),
	)
	.slice(0, 3)
	.map((study) => {
		const kind = category(study);
		return {
			id: study.id,
			href: `/${study.id}/`,
			title: study.data.title,
			description: study.data.description,
			category: kind,
			label: label(kind),
			tools: study.data.tools ?? [],
			tags: study.data.tags ?? [],
			addedAt: study.data.addedAt ?? "",
			search: "",
		};
	});

// The only authorised `sameAs` URLs are the Markdown links in the profiles page;
// derive them from that raw body so no URL is hand-copied into this file.
// The docs loader strips a trailing `/index` from `entry.id`, so match the
// profiles page by id or, defensively, by its file path.
const profilesEntry = allDocs.find(
	({ id, filePath }) =>
		id === "profiles" ||
		(filePath ?? "").replace(/\\/g, "/").endsWith("profiles/index.md"),
);
const profilesBody = profilesEntry?.body ?? "";
const sameAs = [
	...profilesBody.matchAll(/\]\((https?:\/\/[^)\s]+)\)/g),
].map((match) => match[1]);

const jsonLd = {
	"@context": "https://schema.org",
	"@graph": [
		{
			"@type": "WebSite",
			name: "taktak.hu",
			url: "https://taktak.hu/",
			description,
			author: { "@id": PERSON_ID },
			publisher: { "@id": PERSON_ID },
		},
		{ ...PERSON, sameAs },
	],
};
---

<BaseLayout
	title={title}
	description={description}
	canonical="https://taktak.hu/"
	ogType="website"
	jsonLd={jsonLd}
	currentPath="/"
>
	{/* Legacy deep links: before the redesign the explorer lived on `/` and
	    encoded its view as `?kind/q/sort#explorer`. It now lives at
	    `/case-studies/` with the same URL contract, so forward those old URLs
	    once, verbatim, and leave an ordinary homepage visit untouched. */}
	<script is:inline>
		(() => {
			const params = new URLSearchParams(window.location.search);
			const validKinds = ["all", "linux", "windows", "dfir", "soc"];
			const hasValidKind = ["kind", "focus"].some((name) =>
				validKinds.includes(params.get(name) ?? ""),
			);
			if (
				window.location.hash === "#explorer" ||
				hasValidKind
			) {
				window.location.replace(
					"/case-studies/" + window.location.search + window.location.hash,
				);
			}
		})();
	</script>
	<main id="main-content" tabindex="-1">
		<div class="mx-auto w-full max-w-[var(--portfolio-max-width)] px-4 lg:px-8">
			<HomeHero studies={railStudies} />
			<FocusCards />
		</div>
	</main>
</BaseLayout>
